{
  "name": "evyap-accounts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:generate && next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "db:generate": "node scripts/set-provider.mjs && prisma generate",
    "db:push": "node scripts/set-provider.mjs && prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^3.4.5",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "papaparse": "^5.7.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "tsx": "^4.23.15",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
