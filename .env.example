# --- Database ---
# Local dev (SQLite, no server needed):
DATABASE_URL="file:./dev.db"
# Docker Compose / production (PostgreSQL):
# DATABASE_URL="postgresql://evyap:evyap@db:5432/evyap?schema=public"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- Seeded owner account (used by `npm run db:seed`) ---
SEED_OWNER_EMAIL="owner@evyap.local"
SEED_OWNER_PASSWORD="ChangeMe-EVyap-2026"
# Set to "true" to also load the acceptance-test demo data (year 2026)
SEED_DEMO="false"

# --- Optional AI categorisation of unmatched import rows ---
AI_CATEGORISE="false"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
